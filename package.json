{
  "name": "gsea-teachers-portal",
  "version": "1.0.0",
  "description": "ENAC GSEA English Multi-Semester Teachers Hub & Grading Portal",
  "main": "index.html",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --minify",
    "build": "node scripts/build-html.js && npx @tailwindcss/cli -i ./src/input.css -o ./output.css --minify",
    "package": "npm run build && node scripts/validate-syntax.js && node scripts/package-scorm.js && node scripts/package-iso.js",
    "package:scorm": "node scripts/package-scorm.js",
    "package:iso": "node scripts/package-iso.js",
    "backup": "node scripts/backup.js",
    "portfolio:s1": "node scripts/update-portfolio.js 1 && npm run package",
    "portfolio:s2": "node scripts/update-portfolio.js 2 && npm run package",
    "portfolio:s3": "node scripts/update-portfolio.js 3 && npm run package",
    "portfolio:s4": "node scripts/update-portfolio.js 4 && npm run package",
    "portfolio:update": "node scripts/update-portfolio.js",
    "media:update": "node scripts/update-media.js && npm run package",
    "dev:css": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --watch",
    "serve": "python3 -m http.server 8080",
    "test": "node scripts/validate-syntax.js",
    "bug": "node scripts/validate-syntax.js",
    "build:html": "node scripts/build-html.js",
    "backupt": "node scripts/backup.js teachers",
    "backup:teachers": "node scripts/backup.js teachers",
    "backup:all": "node scripts/backup.js all",
    "backup1": "node scripts/backup.js semester1",
    "backup2": "node scripts/backup.js semester2",
    "backup3": "node scripts/backup.js semester3",
    "bug:check": "node scripts/validate-syntax.js",
    "strip": "node scripts/strip-icons.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerforcemotiondrive-pixel/GSEA_teachers.git"
  },
  "keywords": [
    "enac",
    "gsea",
    "teachers",
    "portal",
    "faculty",
    "grading",
    "scorm"
  ],
  "author": "Phil PARRIS",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
